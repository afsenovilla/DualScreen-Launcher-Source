<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:name=".DualScreenLauncherApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DualScreenLauncher">

        <activity
            android:name=".session.GameSessionActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.DualScreenLauncher.Fullscreen" />

        <activity
            android:name=".session.CompanionDisplayCoverActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:taskAffinity="com.dualscreen.launcher.companion.cover"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation|uiMode"
            android:theme="@style/Theme.DualScreenLauncher.CompanionCover" />

        <activity
            android:name=".LauncherActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".LauncherUpdateReceiver"
            android:exported="false" />

        <service
            android:name=".switch.SwitchContentWorkerService"
            android:exported="false"
            android:process=":eden_content" />

        <meta-data
            android:name="android.allow_multiple_resumed_activities"
            android:value="true" />
    </application>
</manifest>
